{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "config/**/*",
    "api/**/*",
    "vite.config.ts"
  ]
}
