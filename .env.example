# Modelo do arquivo .env.local (copie para .env.local e preencha). NUNCA coloque valores reais aqui.
# .env.local fica só no seu computador e é ignorado pelo git.

# Públicos (vão para o navegador; sozinhos não dão poder, quem protege é o RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SECRETOS (só servidor: .env.local e variáveis da Vercel). Nunca no navegador, nunca no chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
